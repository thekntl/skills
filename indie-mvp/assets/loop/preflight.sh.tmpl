#!{{ABSOLUTE_OWNER_REVIEWED_BASH_EXECUTABLE}}
set -euo pipefail
builtin unset BASH_ENV ENV NODE_OPTIONS NODE_PATH

case "${BASH_SOURCE[0]}" in
  /*) loop_script="${BASH_SOURCE[0]}" ;;
  *) loop_script="${PWD}/${BASH_SOURCE[0]}" ;;
esac
loop_root="${loop_script%/*}"

"{{ABSOLUTE_OWNER_REVIEWED_NODE_EXECUTABLE}}" \
  "{{INDIE_MVP_SKILL_PATH}}/scripts/loop-safety.mjs" \
  --loop-root "${loop_root}"
