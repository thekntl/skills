# Separate owner-reviewed staging values for shared-platform.yml.
FOUNDATION_STATE=BLOCKED_OWNER_VERIFICATION
FOUNDATION_CONTRACT_EVIDENCE={{STAGING_INFRASTRUCTURE_ISSUE_URL}}
ENVIRONMENT=staging
STACK_NAME={{indie-platform-staging}}

# Full immutable references only: registry/repository@sha256:<64 hex>.
POSTGRES_IMAGE={{OWNER_SELECTED_POSTGRES_IMAGE_DIGEST}}
FREESCOUT_IMAGE={{OWNER_SELECTED_FREESCOUT_IMAGE_DIGEST}}
POSTGRES_MAJOR={{OWNER_SELECTED_POSTGRES_MAJOR}}
POSTGRES_ARCHITECTURE={{OWNER_SELECTED_LINUX_AMD64_OR_ARM64}}
FREESCOUT_ARCHITECTURE={{OWNER_SELECTED_LINUX_AMD64_OR_ARM64}}

# PostgreSQL 17 and below: /var/lib/postgresql/data.
# PostgreSQL 18 and above: use the version-aware /var/lib/postgresql contract
# only after the selected major, PGDATA, upgrade, and FreeScout compatibility pass staging.
POSTGRES_DATA_TARGET={{OWNER_REVIEWED_VERSION_AWARE_TARGET}}

BACKEND_NETWORK={{STAGING_PRIVATE_OVERLAY_NETWORK}}
INGRESS_NETWORK={{STAGING_INGRESS_OVERLAY_NETWORK}}
POSTGRES_VOLUME={{STAGING_POSTGRES_VOLUME}}
FREESCOUT_DATA_VOLUME={{STAGING_FREESCOUT_DATA_VOLUME}}

POSTGRES_NODE_LABEL={{STAGING_POSTGRES_PLACEMENT_CONSTRAINT}}
FREESCOUT_NODE_LABEL={{STAGING_FREESCOUT_PLACEMENT_CONSTRAINT}}

POSTGRES_ADMIN_USER_SECRET={{STAGING_POSTGRES_ADMIN_USER_SECRET}}
POSTGRES_ADMIN_PASSWORD_SECRET={{STAGING_POSTGRES_ADMIN_PASSWORD_SECRET}}
FREESCOUT_DB_PASSWORD_SECRET={{STAGING_FREESCOUT_DB_PASSWORD_SECRET}}
FREESCOUT_APP_KEY_SECRET={{STAGING_FREESCOUT_APP_KEY_SECRET}}

POSTGRES_CPU_LIMIT={{OWNER_REVIEWED_LIMIT}}
POSTGRES_MEMORY_LIMIT={{OWNER_REVIEWED_LIMIT}}
POSTGRES_CPU_RESERVATION={{OWNER_REVIEWED_RESERVATION}}
POSTGRES_MEMORY_RESERVATION={{OWNER_REVIEWED_RESERVATION}}
FREESCOUT_CPU_LIMIT={{OWNER_REVIEWED_LIMIT}}
FREESCOUT_MEMORY_LIMIT={{OWNER_REVIEWED_LIMIT}}
FREESCOUT_CPU_RESERVATION={{OWNER_REVIEWED_RESERVATION}}
FREESCOUT_MEMORY_RESERVATION={{OWNER_REVIEWED_RESERVATION}}

FREESCOUT_HOSTNAME={{STAGING_SUPPORT_HOSTNAME}}
FREESCOUT_DB_NAME={{STAGING_FREESCOUT_DATABASE}}
FREESCOUT_DB_USER={{STAGING_FREESCOUT_ROLE}}
FREESCOUT_SETUP_TYPE={{OWNER_REVIEWED_MANUAL_OR_AUTO}}
FREESCOUT_SCHEDULER_TYPE={{OWNER_REVIEWED_SERVICE_OR_CRON}}
FREESCOUT_ENABLE_AUTO_UPDATE=FALSE

# Deliberately absent until the pinned image resolves the upstream/container
# DB_PGSQL_SSLMODE versus FREESCOUT_DB_PGSQL_SSL_MODE mismatch:
# FREESCOUT_POSTGRES_TLS_SETTING={{BLOCKED_OWNER_VERIFICATION}}

# Add reverse-proxy labels only after proxy CIDRs, forwarded headers, TLS,
# cache behavior, ingress provider, and networks are reviewed in staging.
