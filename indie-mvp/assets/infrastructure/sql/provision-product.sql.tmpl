\set ON_ERROR_STOP on

-- Supply psql variables through the owner's approved secret/runtime path:
-- product_database, product_role, product_password.
-- Review identifiers before execution. Do not store product_password in the repository.

CREATE ROLE :"product_role"
  LOGIN
  NOSUPERUSER
  NOCREATEDB
  NOCREATEROLE
  NOINHERIT
  NOREPLICATION
  PASSWORD :'product_password';

CREATE DATABASE :"product_database"
  OWNER :"product_role"
  ENCODING 'UTF8'
  TEMPLATE template0;

\connect :"product_database"

REVOKE ALL ON DATABASE :"product_database" FROM PUBLIC;
REVOKE CREATE ON SCHEMA public FROM PUBLIC;
GRANT CONNECT, TEMPORARY ON DATABASE :"product_database" TO :"product_role";
GRANT USAGE, CREATE ON SCHEMA public TO :"product_role";

COMMENT ON DATABASE :"product_database" IS 'Isolated Indie MVP product database';
COMMENT ON ROLE :"product_role" IS 'Least-privilege Indie MVP product login';
