# Separate owner-reviewed production values for shared-platform.yml.
FOUNDATION_STATE=BLOCKED_OWNER_VERIFICATION
FOUNDATION_CONTRACT_EVIDENCE={{PRODUCTION_INFRASTRUCTURE_ISSUE_URL}}
ENVIRONMENT=production
STACK_NAME={{indie-platform-production}}

# Promote only the exact immutable references and compatibility set proven in staging.
POSTGRES_IMAGE={{STAGING_PROVEN_POSTGRES_IMAGE_DIGEST}}
FREESCOUT_IMAGE={{STAGING_PROVEN_FREESCOUT_IMAGE_DIGEST}}
POSTGRES_MAJOR={{STAGING_PROVEN_POSTGRES_MAJOR}}
POSTGRES_ARCHITECTURE={{STAGING_PROVEN_LINUX_AMD64_OR_ARM64}}
FREESCOUT_ARCHITECTURE={{STAGING_PROVEN_LINUX_AMD64_OR_ARM64}}
POSTGRES_DATA_TARGET={{STAGING_PROVEN_VERSION_AWARE_TARGET}}

BACKEND_NETWORK={{PRODUCTION_PRIVATE_OVERLAY_NETWORK}}
INGRESS_NETWORK={{PRODUCTION_INGRESS_OVERLAY_NETWORK}}
POSTGRES_VOLUME={{PRODUCTION_POSTGRES_VOLUME}}
FREESCOUT_DATA_VOLUME={{PRODUCTION_FREESCOUT_DATA_VOLUME}}

POSTGRES_NODE_LABEL={{PRODUCTION_POSTGRES_PLACEMENT_CONSTRAINT}}
FREESCOUT_NODE_LABEL={{PRODUCTION_FREESCOUT_PLACEMENT_CONSTRAINT}}

POSTGRES_ADMIN_USER_SECRET={{PRODUCTION_POSTGRES_ADMIN_USER_SECRET}}
POSTGRES_ADMIN_PASSWORD_SECRET={{PRODUCTION_POSTGRES_ADMIN_PASSWORD_SECRET}}
FREESCOUT_DB_PASSWORD_SECRET={{PRODUCTION_FREESCOUT_DB_PASSWORD_SECRET}}
FREESCOUT_APP_KEY_SECRET={{PRODUCTION_FREESCOUT_APP_KEY_SECRET}}

POSTGRES_CPU_LIMIT={{STAGING_PROVEN_LIMIT}}
POSTGRES_MEMORY_LIMIT={{STAGING_PROVEN_LIMIT}}
POSTGRES_CPU_RESERVATION={{STAGING_PROVEN_RESERVATION}}
POSTGRES_MEMORY_RESERVATION={{STAGING_PROVEN_RESERVATION}}
FREESCOUT_CPU_LIMIT={{STAGING_PROVEN_LIMIT}}
FREESCOUT_MEMORY_LIMIT={{STAGING_PROVEN_LIMIT}}
FREESCOUT_CPU_RESERVATION={{STAGING_PROVEN_RESERVATION}}
FREESCOUT_MEMORY_RESERVATION={{STAGING_PROVEN_RESERVATION}}

FREESCOUT_HOSTNAME={{PRODUCTION_SUPPORT_HOSTNAME}}
FREESCOUT_DB_NAME={{PRODUCTION_FREESCOUT_DATABASE}}
FREESCOUT_DB_USER={{PRODUCTION_FREESCOUT_ROLE}}
FREESCOUT_SETUP_TYPE={{STAGING_PROVEN_MANUAL_OR_AUTO}}
FREESCOUT_SCHEDULER_TYPE={{STAGING_PROVEN_SERVICE_OR_CRON}}
FREESCOUT_ENABLE_AUTO_UPDATE=FALSE

# Do not add a PostgreSQL TLS variable until the pinned image contract and
# secure network design have been verified and recorded.

# FOUNDATION_STATE may become PRODUCTION_READY only after the staging-proven
# compatibility contract is preserved and production-specific evidence, owner
# approval, complete deployment-contract fingerprint, and rollback review exist.
